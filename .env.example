# OpenAI-compatible endpoint used by the generation and feature-summary code.
OPENAI_BASE_URL=
OPENAI_API_KEY=

# Optional model aliases used by the experiment drivers.
FEATLENS_MODEL=
FEATLENS_REASONING_MODEL=
REPOGRAPH_MODEL=
CODEXGRAPH_MODEL=
REPOSCOPE_MODEL=

# Optional provider-specific credentials/endpoints.
GPT_API_KEY=
GPT_BASE_URL=
CLAUDE_API_KEY=
CLAUDE_BASE_URL=
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=

# Optional external inputs; relative paths are resolved against this package.
# Source repositories and dependency-test assets are NOT included in the archive.
FEATLENS_DEVEVAL_SOURCE_ROOT=external/deveval/source_code
FEATLENS_EVOCODEBENCH_SOURCE_ROOT=external/evocodebench/source_code
FEATLENS_DEPENDENCY_DATA_ROOT=external/deveval/dependency_data
FEATLENS_DEVEVAL_BENCHMARK_ROOT=external/deveval
FEATLENS_PROJECT_LIST_ROOT=external/project_lists
FEATLENS_EVAL_WORKSPACE=work/evaluation

# Leave blank to use the Python interpreter running the script.
FEATLENS_EVAL_PYTHON=

# Local model directories or model identifiers (weights are not included).
FEATLENS_MINILM_MODEL=sentence-transformers/all-MiniLM-L6-v2
FEATLENS_BGE_MODEL=BAAI/bge-code-v1
FEATLENS_UNIXCODER_MODEL=microsoft/unixcoder-base
